{
  "title": "BuySearchSell Scraper Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "startUrl": {
      "title": "Start URL",
      "type": "string",
      "description": "The category page URL to start scraping from",
      "default": "https://www.buysearchsell.com.au/all-locations/trades-services/",
      "editor": "textfield",
      "prefill": "https://www.buysearchsell.com.au/all-locations/trades-services/"
    },
    "maxResults": {
      "title": "Max Results",
      "type": "integer",
      "description": "Maximum number of listings to scrape",
      "default": 100,
      "minimum": 1,
      "maximum": 10000,
      "editor": "number"
    },
    "proxyConfiguration": {
      "title": "Proxy Configuration",
      "type": "object",
      "description": "Proxy settings for the scraper",
      "prefill": {
        "useApifyProxy": true
      },
      "editor": "proxy"
    }
  },
  "required": []
}
